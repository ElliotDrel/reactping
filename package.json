{
  "name": "reactping",
  "version": "1.1.2",
  "private": true,
  "license": "MIT",
  "description": "Slack app that DMs you when someone reacts to your messages.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "db:test:start": "docker run -d --rm --name reactping-test-db -p 54329:5432 -e POSTGRES_PASSWORD=postgres postgres:17-alpine",
    "db:test:stop": "docker stop reactping-test-db",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@slack/web-api": "^8.2.0",
    "@vercel/functions": "3.10.6",
    "marked": "18.1.3",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0"
  }
}
