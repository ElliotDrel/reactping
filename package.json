{
  "name": "reactping",
  "version": "0.0.0",
  "private": true,
  "description": "Slack bot DMs when someone reacts to your messages.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "node --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@slack/web-api": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0"
  }
}
