# ReactPing environment contract. Copy to .env for local development; set the same names in Vercel.
# Never commit real values. Vercel: set each variable for the environments that need it.

# ---------------------------------------------------------------------------
# Browser-safe (PUBLIC_*). Read at build time and embedded in the static site,
# and read by the API at runtime. Must never contain a secret.
# ---------------------------------------------------------------------------

# Canonical origin, no trailing slash. Slack OAuth and event URLs live under it.
# Leave empty until a domain is chosen (no canonical links or sitemap are emitted).
PUBLIC_SITE_URL=
# Supabase project URL and *publishable* key (sb_publishable_... or the legacy anon key).
# The build fails if a secret or service-role key is put here.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Launch toggle for the website only: shows installs as open. Does NOT enable installs on the server.
PUBLIC_INSTALL_ENABLED=false
# Allow search indexing. Requires PUBLIC_SITE_URL; always ignored on Vercel preview deployments.
PUBLIC_SITE_INDEXABLE=false
# Optional public support email shown on FAQ/privacy/terms. Empty shows "not published yet".
PUBLIC_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Server secrets. Read only by the API function at runtime. Never PUBLIC_.
# ---------------------------------------------------------------------------

# Supabase Postgres connection string (transaction pooler, port 6543, for serverless).
DATABASE_URL=
# Slack app "Basic Information" page.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes stored tokens unreadable; every workspace must then reconnect.
ENCRYPTION_KEY=
# Bearer secret for POST /api/internal/deliver (Supabase pg_cron). At least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DELIVERY_CRON_SECRET=

# ---------------------------------------------------------------------------
# Operator flags (server only).
# ---------------------------------------------------------------------------

# Allow new Slack installs. Default false. Independent of PUBLIC_INSTALL_ENABLED.
REACTPING_INSTALLS_ENABLED=false
# Testing only: include reactions you add to your own messages. Normal default: false.
INCLUDE_SELF_REACTIONS=false

# ---------------------------------------------------------------------------
# Local only.
# ---------------------------------------------------------------------------

# Port for `npm run dev`.
PORT=3000
# Disposable Postgres for the integration tests (`npm run db:test:start`). Never a real database.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
