# Public HTTPS origin Slack reaches (tunnel or host), no trailing slash.
BASE_URL=https://your-tunnel.example.com
PORT=3000
DATABASE_PATH=./data/reactping.sqlite

# Slack app "Basic Information" page.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes stored tokens unreadable; workspaces must then reconnect.
ENCRYPTION_KEY=

# Hours to keep minimal reaction/delivery records (default 48, minimum 1).
RETENTION_HOURS=48

# Testing only: include reactions you add to your own messages. Normal default: false.
INCLUDE_SELF_REACTIONS=false

# Optional: serve HTTPS directly instead of behind a TLS-terminating proxy/tunnel.
TLS_CERT_FILE=
TLS_KEY_FILE=
