# ReactPing environment contract. Server-side only: the website is static and reads no configuration.
# Set these in Vercel for the environments that need them. Never commit real values.

# Canonical public origin, no trailing slash (for example https://reactping.com). The Slack OAuth
# redirect is <PUBLIC_SITE_URL>/api/slack/oauth/callback; "Add to Slack" is always started on this host.
PUBLIC_SITE_URL=

# Supabase Postgres connection string (transaction pooler, port 6543, for serverless).
# Remote connections use verified TLS. Omit ssl/sslmode/sslcert/sslkey/sslrootcert URL parameters.
DATABASE_URL=
# Optional PEM CA certificate from the provider when system trust does not validate its certificate.
# Supply the full multiline PEM in Vercel's environment settings; verification is never disabled.
DATABASE_CA=

# Slack app "Basic Information" page.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keys for token encryption and the OAuth state cookie are derived from it. Changing it makes stored tokens
# unreadable; everyone must then add ReactPing to Slack again.
ENCRYPTION_KEY=

# Testing only: also notify about reactions you add to your own messages. Normal default: false.
INCLUDE_SELF_REACTIONS=false
